[node name="Dialogue" type="Node" parent="TalkBody"]
unique_name_in_owner = true
script = ExtResource("3_dialogue")
speaker_name = "The Carver"
first_lines = PackedStringArray("Ah. Footsteps, and no face above them. Come closer, little one. The stump does not mind company.", "Every face in this valley passed under my knife. Every brow, every grin, every scowl the bandits wear. I remember the grain of each.", "But not yours. A thousand winters I have searched the wood, and your face was never in it.", "Perhaps that is why my mouth turns down. Go. Wear what the Monger sells you. I will keep carving.")
repeat_lines = PackedStringArray("Still faceless. Still welcome. Sit, if you like. The wood talks, for those who wait.")
voice = ExtResource("4_voice")
talk_range = 6.0
